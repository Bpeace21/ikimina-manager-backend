  "item": [
    {
      "name": "Setup (run these 3 first)",
      "item": [
        {
          "name": "Setup 1 - get loan ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const loans = pm.response.json();",
                  "const pick = s => loans.find(l => l.status === s);",
                  "const set = (k, l) => { if (l) pm.collectionVariables.set(k, l.id); };",
                  "set('loanRequestedId', pick('REQUESTED'));",
                  "set('loanApprovedId', pick('APPROVED'));",
                  "set('loanDisbursedId', pick('DISBURSED'));",
                  "const d = pick('DISBURSED');",
                  "if (d) pm.collectionVariables.set('disbursedMemberNumber', d.member.memberNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "all"
              ]
            }
          }
        },
        {
          "name": "Setup 2 - get product ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const ps = pm.response.json();",
                  "const a = ps.find(p => p.name === 'Agriculture');",
                  "if (a) pm.collectionVariables.set('agricultureId', a.id);",
                  "pm.collectionVariables.set('productsJson', JSON.stringify(ps));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loan-products/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-products",
                "all"
              ]
            }
          }
        },
        {
          "name": "Setup 3 - pick product for D3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const ts = pm.response.json();",
                  "const ps = JSON.parse(pm.collectionVariables.get('productsJson') || '[]');",
                  "const eric = ts.find(t => t.id === pm.collectionVariables.get('tEric'));",
                  "const held = (eric && eric.loanProducts ? eric.loanProducts : []).map(p => p.id);",
                  "const free = ps.find(p => p.name !== 'Agriculture' && !held.includes(p.id));",
                  "const chosen = free || ps.find(p => p.name === 'Agriculture') || ps[0];",
                  "if (chosen) pm.collectionVariables.set('d3ProductId', chosen.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/treasurers/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "treasurers",
                "all"
              ]
            }
          }
        }
      ]
    },
